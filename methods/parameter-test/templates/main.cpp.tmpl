#include <iostream>

int main(
    int argc,
    char* argv[]
)
{
    constexpr bool enabled =
        {{PARAM_ENABLED}};

    constexpr int repeat =
        {{PARAM_REPEAT}};

    const char* message =
        "{{PARAM_MESSAGE}}";

    if (argc > 1)
    {
        std::cout
            << "["
            << argv[1]
            << "] "
            << std::endl;
    }

    if (!enabled)
    {
        std::cout
            << "[i] Output disabled by build parameter"
            << std::endl;

        return 0;
    }

    for (
        int index = 0;
        index < repeat;
        ++index
    )
    {
        std::cout
            << message
            << std::endl;
    }

    return 0;
}
