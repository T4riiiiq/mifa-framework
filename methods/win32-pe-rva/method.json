      "output": "main.cpp",
      "compile": true
    },
    {
      "template": "templates/pe_rva.cpp.tmpl",
      "output": "pe_rva.cpp",
      "compile": true
    },
    {
      "template": "templates/pe_rva.hpp.tmpl",
      "output": "pe_rva.hpp",
      "compile": false
    }
  ],
  "output_name": "win32-pe-rva.exe"
}
