{
  "id": "win32-payload-inspect",
  "name": "Win32 Payload Contract Inspector",
  "language": "c",
  "description": "Print build-time Payload Contract v2 metadata for a staged input without loading or executing the payload contents.",
  "architectures": [
    "x64",
    "x86"
  ],
  "requires_payload": true,
  "payload_types": [
    "raw",
    "text",
    "json",
    "pe"
  ],
  "payload_contract": {
    "required": true,
    "types": [
      "raw",
      "text",
      "json",
      "pe"
    ],
    "transforms": [
      "copy",
      "base64",
      "hex"
    ],
    "default_transform": "copy",
    "min_size_bytes": 1,
    "max_size_bytes": 16777216
  },
  "build_types": [
    "release",
    "debug"
  ],
  "parameters": {},
  "runtime_arguments": [],
  "sources": [
    {
      "template": "templates/main.c.tmpl",
      "output": "main.c",
      "compile": true
    }
  ],
  "output_name": "win32-payload-inspect.exe"
}
