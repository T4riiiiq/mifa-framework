#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <ctype.h>
#include <string.h>

static int b64_value(unsigned char c) {
    if (c >= 'A' && c <= 'Z') return (int)(c - 'A');
    if (c >= 'a' && c <= 'z') return (int)(c - 'a') + 26;
    if (c >= '0' && c <= '9') return (int)(c - '0') + 52;
    if (c == '+') return 62;
    if (c == '/') return 63;
    return -1;
}

static void print_preview(const unsigned char *data, size_t size, size_t limit) {
    size_t shown = size < limit ? size : limit;
    for (size_t i = 0; i < shown; ++i) {
        if ((i % 16) == 0) printf("  ");
        printf("%02X", data[i]);
        if ((i % 16) == 15 || i + 1 == shown) printf("\n");
        else printf(" ");
    }
}

static unsigned char *read_file(const char *path, size_t max_size, size_t *out_size) {
    FILE *f = fopen(path, "rb");
    long length;
    unsigned char *data;
    size_t got;
    if (!f) return NULL;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
    length = ftell(f);
    if (length < 0 || (size_t)length > max_size) { fclose(f); return NULL; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return NULL; }
    data = (unsigned char *)malloc((size_t)length + 1);
    if (!data) { fclose(f); return NULL; }
    got = fread(data, 1, (size_t)length, f);
    fclose(f);
    if (got != (size_t)length) { free(data); return NULL; }
    data[got] = 0;
    *out_size = got;
    return data;
}

static int decode_base64(const unsigned char *input, size_t input_size, unsigned char **out, size_t *out_size) {
    unsigned char *clean = NULL;
    unsigned char *decoded = NULL;
    size_t clean_len = 0, i, o = 0;
    clean = (unsigned char *)malloc(input_size + 1);
    if (!clean) return 0;
    for (i = 0; i < input_size; ++i) {
        if (!isspace((int)input[i])) clean[clean_len++] = input[i];
    }
    if (clean_len == 0 || (clean_len % 4) != 0) { free(clean); return 0; }
    decoded = (unsigned char *)malloc((clean_len / 4) * 3 + 1);
    if (!decoded) { free(clean); return 0; }
    for (i = 0; i < clean_len; i += 4) {
        int a = b64_value(clean[i]);
        int b = b64_value(clean[i + 1]);
        int c = clean[i + 2] == '=' ? -2 : b64_value(clean[i + 2]);
        int d = clean[i + 3] == '=' ? -2 : b64_value(clean[i + 3]);
        uint32_t triple;
        if (a < 0 || b < 0 || c == -1 || d == -1) { free(clean); free(decoded); return 0; }
        if (c == -2 && d != -2) { free(clean); free(decoded); return 0; }
        if ((c == -2 || d == -2) && i + 4 != clean_len) { free(clean); free(decoded); return 0; }
        triple = ((uint32_t)a << 18) | ((uint32_t)b << 12)
               | ((uint32_t)(c < 0 ? 0 : c) << 6)
               | (uint32_t)(d < 0 ? 0 : d);
        decoded[o++] = (unsigned char)((triple >> 16) & 0xFF);
        if (c != -2) decoded[o++] = (unsigned char)((triple >> 8) & 0xFF);
        if (d != -2) decoded[o++] = (unsigned char)(triple & 0xFF);
    }
    free(clean);
    *out = decoded;
    *out_size = o;
    return 1;
}

int main(int argc, char **argv) {
    const size_t max_input = (size_t){{PARAM_MAX_INPUT_BYTES}};
    const size_t preview = (size_t){{PARAM_PREVIEW_BYTES}};
    unsigned char *input = NULL, *decoded = NULL;
    size_t input_size = 0, decoded_size = 0;
    if (argc != 2) {
        fprintf(stderr, "Usage: %s <base64_path>\n", argv[0]);
        return 2;
    }
    input = read_file(argv[1], max_input, &input_size);
    if (!input) {
        fprintf(stderr, "Unable to read input or input exceeds limit\n");
        return 3;
    }
    if (!decode_base64(input, input_size, &decoded, &decoded_size)) {
        fprintf(stderr, "Invalid Base64 input\n");
        free(input);
        return 4;
    }
    printf("Mifa Base64 Buffer Decoder\n");
    printf("Build         : {{BUILD_ID}}\n");
    printf("Architecture  : {{ARCH}}\n");
    printf("Input bytes   : %llu\n", (unsigned long long)input_size);
    printf("Decoded bytes : %llu\n", (unsigned long long)decoded_size);
    printf("Execution     : no\n");
    printf("Preview       :\n");
    print_preview(decoded, decoded_size, preview);
    free(decoded);
    free(input);
    return 0;
}
