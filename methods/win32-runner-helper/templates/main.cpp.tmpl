#include <windows.h>
#include <fstream>
#include <iostream>
#include <string>
#include <vector>

static const char* binary_type_name(
    DWORD type
)
{
    switch (type)
    {
        case SCS_32BIT_BINARY:
            return "32-bit";

        case SCS_64BIT_BINARY:
            return "64-bit";

        case SCS_DOS_BINARY:
            return "DOS";

        case SCS_WOW_BINARY:
            return "WOW";

        default:
            return "other";
    }
}

int main(
    int argc,
    char* argv[]
)
{
    std::cout
        << "Mifa Runtime Input Helper\n"
        << "Build: {{BUILD_ID}}\n"
        << "Architecture: {{ARCH}}\n\n";

    if (argc != 2)
    {
        std::cerr
            << "Usage: win32-runner-helper.exe "
            << "<input-path>\n";

        return 2;
    }

    std::ifstream file(
        argv[1],
        std::ios::binary
    );

    if (!file)
    {
        std::cerr
            << "[!] Unable to open input\n";

        return 1;
    }

    file.seekg(
        0,
        std::ios::end
    );

    std::streamoff size =
        file.tellg();

    file.seekg(
        0,
        std::ios::beg
    );

    unsigned char prefix[2] = {};

    if (size >= 2)
    {
        file.read(
            reinterpret_cast<char*>(prefix),
            sizeof(prefix)
        );
    }

    bool mz =
        size >= 2
        && prefix[0] == 'M'
        && prefix[1] == 'Z';

    std::cout
        << "[+] Input: "
        << argv[1]
        << "\n";

    std::cout
        << "[+] Size: "
        << static_cast<long long>(size)
        << " bytes\n";

    std::cout
        << "[+] MZ signature: "
        << (mz ? "yes" : "no")
        << "\n";

    DWORD type = 0;

    if (
        mz
        && GetBinaryTypeA(
            argv[1],
            &type
        )
    )
    {
        std::cout
            << "[+] Binary type: "
            << binary_type_name(type)
            << "\n";
    }

    std::cout
        << "[+] Input loaded as executable: no\n"
        << "[+] Input executed: no\n";

    return 0;
}
