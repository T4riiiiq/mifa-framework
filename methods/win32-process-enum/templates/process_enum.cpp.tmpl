#include "process_enum.hpp"

#include <tlhelp32.h>
#include <iostream>


std::string query_process_image_path(
    DWORD process_id
)
{
    HANDLE process_handle =
        OpenProcess(
            PROCESS_QUERY_LIMITED_INFORMATION,
            FALSE,
            process_id
        );

    if (process_handle == nullptr)
    {
        return "<unavailable>";
    }


    char image_path[32768] = {};

    DWORD image_path_size =
        static_cast<DWORD>(
            sizeof(image_path)
        );


    BOOL result =
        QueryFullProcessImageNameA(
            process_handle,
            0,
            image_path,
            &image_path_size
        );


    CloseHandle(
        process_handle
    );


    if (!result)
    {
        return "<unavailable>";
    }


    return std::string(
        image_path,
        image_path_size
    );
}


bool enumerate_processes()
{
    HANDLE snapshot =
        CreateToolhelp32Snapshot(
            TH32CS_SNAPPROCESS,
            0
        );


    if (snapshot == INVALID_HANDLE_VALUE)
    {
        std::cerr
            << "[!] CreateToolhelp32Snapshot failed"
            << std::endl;

        return false;
    }


    PROCESSENTRY32 process_entry{};

    process_entry.dwSize =
        sizeof(PROCESSENTRY32);


    if (!Process32First(
        snapshot,
        &process_entry
    ))
    {
        std::cerr
            << "[!] Process32First failed"
            << std::endl;

        CloseHandle(
            snapshot
        );

        return false;
    }


    std::size_t process_count = 0;


    std::cout
        << "PID\tPPID\tTHREADS\tNAME\tPATH"
        << std::endl;


    do
    {
        ProcessRecord record{};

        record.process_id =
            process_entry.th32ProcessID;

        record.parent_process_id =
            process_entry.th32ParentProcessID;

        record.thread_count =
            process_entry.cntThreads;

        record.executable_name =
            process_entry.szExeFile;

        record.image_path =
            query_process_image_path(
                record.process_id
            );


        std::cout
            << record.process_id
            << "\t"

            << record.parent_process_id
            << "\t"

            << record.thread_count
            << "\t"

            << record.executable_name
            << "\t"

            << record.image_path
            << std::endl;


        ++process_count;

    }
    while (
        Process32Next(
            snapshot,
            &process_entry
        )
    );


    CloseHandle(
        snapshot
    );


    std::cout
        << std::endl
        << "[+] Processes enumerated: "
        << process_count
        << std::endl;


    return true;
}
