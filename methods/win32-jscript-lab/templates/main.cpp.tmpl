#include <windows.h>

#include <algorithm>
#include <cctype>
#include <fstream>
#include <iostream>
#include <string>
#include <vector>


static std::string lower_copy(
    std::string value
)
{
    std::transform(
        value.begin(),
        value.end(),
        value.begin(),
        [](unsigned char c)
        {
            return static_cast<char>(
                std::tolower(c)
            );
        }
    );

    return value;
}


static std::string extension_of(
    const std::string& path
)
{
    std::size_t slash =
        path.find_last_of("\\/");

    std::size_t dot =
        path.find_last_of('.');

    if (
        dot == std::string::npos
        || (
            slash != std::string::npos
            && dot < slash
        )
    )
    {
        return {};
    }

    return lower_copy(
        path.substr(dot)
    );
}


static bool file_exists(
    const std::string& path
)
{
    DWORD attributes =
        GetFileAttributesA(
            path.c_str()
        );

    return attributes
        != INVALID_FILE_ATTRIBUTES
        && !(attributes & FILE_ATTRIBUTE_DIRECTORY);
}


static bool read_file(
    const std::string& path,
    std::size_t max_size,
    std::vector<unsigned char>& data
)
{
    std::ifstream file(
        path,
        std::ios::binary
    );

    if (!file)
    {
        return false;
    }

    file.seekg(
        0,
        std::ios::end
    );

    std::streamoff size =
        file.tellg();

    if (
        size < 0
        || static_cast<std::size_t>(size)
            > max_size
    )
    {
        return false;
    }

    file.seekg(
        0,
        std::ios::beg
    );

    data.resize(
        static_cast<std::size_t>(size)
    );

    if (
        !data.empty()
        && !file.read(
            reinterpret_cast<char*>(
                data.data()
            ),
            size
        )
    )
    {
        return false;
    }

    return true;
}


static bool starts_with(
    const std::vector<unsigned char>& data,
    const char* marker
)
{
    std::size_t length = 0;

    while (marker[length] != '\0')
    {
        ++length;
    }

    if (data.size() < length)
    {
        return false;
    }

    for (
        std::size_t i = 0;
        i < length;
        ++i
    )
    {
        if (
            data[i]
            != static_cast<unsigned char>(
                marker[i]
            )
        )
        {
            return false;
        }
    }

    return true;
}


static double printable_ratio(
    const std::vector<unsigned char>& data
)
{
    if (data.empty())
    {
        return 1.0;
    }

    std::size_t printable = 0;

    for (unsigned char c : data)
    {
        if (
            c == '\r'
            || c == '\n'
            || c == '\t'
            || (
                c >= 0x20
                && c <= 0x7e
            )
        )
        {
            ++printable;
        }
    }

    return static_cast<double>(printable)
        / static_cast<double>(data.size());
}


static std::string windows_directory()
{
    char buffer[MAX_PATH] = {};

    UINT length =
        GetWindowsDirectoryA(
            buffer,
            MAX_PATH
        );

    if (
        length == 0
        || length >= MAX_PATH
    )
    {
        return {};
    }

    return std::string(buffer);
}


static void print_host(
    const char* label,
    const std::string& path
)
{
    std::cout
        << "[+] "
        << label
        << ": "
        << (
            file_exists(path)
                ? "present"
                : "absent"
        )
        << "\n";

    if (file_exists(path))
    {
        std::cout
            << "    "
            << path
            << "\n";
    }
}


int main(
    int argc,
    char* argv[]
)
{
    const std::size_t max_size =
        static_cast<std::size_t>(
            {{PARAM_MAX_FILE_BYTES}}
        );

    if (argc != 2)
    {
        std::cerr
            << "Usage: win32-jscript-lab.exe "
            << "<script-path>\n";

        return 2;
    }

    std::vector<unsigned char> data;

    if (
        !read_file(
            argv[1],
            max_size,
            data
        )
    )
    {
        std::cerr
            << "[!] Unable to read script "
            << "or file exceeds configured limit\n";

        return 1;
    }

    std::string extension =
        extension_of(argv[1]);

    bool js_extension =
        extension == ".js";

    bool jse_extension =
        extension == ".jse";

    bool encoded_marker =
        starts_with(
            data,
            "#@~^"
        );

    bool utf8_bom =
        data.size() >= 3
        && data[0] == 0xEF
        && data[1] == 0xBB
        && data[2] == 0xBF;

    bool utf16le_bom =
        data.size() >= 2
        && data[0] == 0xFF
        && data[1] == 0xFE;

    double ratio =
        printable_ratio(data);

    std::cout
        << "Mifa JScript Compatibility Lab\n"
        << "Build: {{BUILD_ID}}\n"
        << "Architecture: {{ARCH}}\n\n";

    std::cout
        << "[+] File: "
        << argv[1]
        << "\n";

    std::cout
        << "[+] Size: "
        << data.size()
        << " bytes\n";

    std::cout
        << "[+] Extension: "
        << (
            extension.empty()
                ? "(none)"
                : extension
        )
        << "\n";

    std::cout
        << "[+] .js input: "
        << (js_extension ? "yes" : "no")
        << "\n";

    std::cout
        << "[+] .jse input: "
        << (jse_extension ? "yes" : "no")
        << "\n";

    std::cout
        << "[+] JScript.Encode marker: "
        << (encoded_marker ? "present" : "absent")
        << "\n";

    std::cout
        << "[+] UTF-8 BOM: "
        << (utf8_bom ? "yes" : "no")
        << "\n";

    std::cout
        << "[+] UTF-16LE BOM: "
        << (utf16le_bom ? "yes" : "no")
        << "\n";

    std::cout
        << "[+] Printable-byte ratio: "
        << static_cast<int>(ratio * 100.0)
        << "%\n";

    std::string win =
        windows_directory();

    if (!win.empty())
    {
        print_host(
            "System32 wscript",
            win + "\\System32\\wscript.exe"
        );

        print_host(
            "System32 cscript",
            win + "\\System32\\cscript.exe"
        );

        print_host(
            "SysWOW64 wscript",
            win + "\\SysWOW64\\wscript.exe"
        );

        print_host(
            "SysWOW64 cscript",
            win + "\\SysWOW64\\cscript.exe"
        );
    }
    else
    {
        std::cout
            << "[!] Windows directory unavailable\n";
    }

    std::cout
        << "[+] Script parsed statically: yes\n"
        << "[+] Script host launched: no\n"
        << "[+] Script executed: no\n";

    return 0;
}
