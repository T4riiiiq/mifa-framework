#include <windows.h>
#include <tlhelp32.h>
#include <cstdlib>
#include <iostream>
#include <limits>
#include <map>
#include <set>
#include <string>
#include <vector>

struct Proc {
    DWORD pid;
    DWORD ppid;
    std::string name;
};

static void print_tree(
    DWORD pid,
    const std::map<DWORD, Proc>& procs,
    const std::map<DWORD, std::vector<DWORD>>& children,
    std::set<DWORD>& visited,
    int depth
) {
    if (visited.count(pid)) return;
    visited.insert(pid);

    auto it = procs.find(pid);
    if (it != procs.end()) {
        std::cout << std::string(depth * 2, ' ')
                  << it->second.pid << "  " << it->second.name << "\n";
    }

    auto c = children.find(pid);
    if (c == children.end()) return;
    for (DWORD child : c->second) {
        print_tree(child, procs, children, visited, depth + 1);
    }
}

int main(int argc, char* argv[]) {
    if (argc != 2) {
        std::cout << "Usage: win32-process-tree.exe <root PID>\n";
        return 1;
    }

    char* end = nullptr;
    unsigned long parsed = std::strtoul(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' ||
        parsed > std::numeric_limits<DWORD>::max()) {
        std::cerr << "[!] Invalid PID\n";
        return 1;
    }
    DWORD root = static_cast<DWORD>(parsed);

    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snapshot == INVALID_HANDLE_VALUE) {
        std::cerr << "[!] Process snapshot failed: " << GetLastError() << "\n";
        return 1;
    }

    PROCESSENTRY32 entry{};
    entry.dwSize = sizeof(entry);
    if (!Process32First(snapshot, &entry)) {
        std::cerr << "[!] Process32First failed: " << GetLastError() << "\n";
        CloseHandle(snapshot);
        return 1;
    }

    std::map<DWORD, Proc> procs;
    std::map<DWORD, std::vector<DWORD>> children;
    do {
        Proc p{entry.th32ProcessID, entry.th32ParentProcessID, entry.szExeFile};
        procs[p.pid] = p;
        children[p.ppid].push_back(p.pid);
    } while (Process32Next(snapshot, &entry));
    CloseHandle(snapshot);

    if (!procs.count(root)) {
        std::cerr << "[!] Root PID not found in current snapshot\n";
        return 1;
    }

    std::cout << "Mifa Win32 Process Tree\n"
              << "Build: {{BUILD_ID}}\n"
              << "Architecture: {{ARCH}}\n"
              << "Root PID: " << root << "\n\n";

    std::set<DWORD> visited;
    print_tree(root, procs, children, visited, 0);
    return 0;
}
